# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_FILE_URL=
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-long-random-secret

MIGRATE_LINKS=safe
SEED_DEMO_DATA=false
ENABLE_ALGOLIA=false
DISABLE_ALGOLIA=true


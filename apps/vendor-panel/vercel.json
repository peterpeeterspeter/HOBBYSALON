{
  "framework": "vite",
  "buildCommand": "yarn build:preview",
  "installCommand": "yarn install",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "fix/startup-pg-auth-propagation": false
    }
  }
}
